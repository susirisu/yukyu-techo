# Firebaseコンソール → プロジェクトの設定 → 全般 → マイアプリ の「SDK の設定と構成」から
# 表示される値をコピーして .env という名前でこのファイルの隣に置いてください（.env はGitには含めません）。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ログインを許可するGoogleアカウントのメールアドレス（カンマ区切りで複数可）。
# Firestoreのルールに書いたメールアドレスと必ず同じ内容にしてください。
VITE_ALLOWED_EMAILS=your-email@gmail.com

